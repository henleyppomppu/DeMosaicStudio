<Project Sdk="Microsoft.NET.Sdk">

  <!--
    prd.md §4.3: the only project that targets Windows, and the only one a Linux test may not reach.
    Everything a test needs lives in Domain, Application or Infrastructure.

    EnableWindowsTargeting lets the whole solution *compile* on Linux, which is what keeps CI able
    to catch a broken XAML binding or a missing type. Running it is Windows-only.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>DeMosaicStudio.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      **WPF does not run under invariant globalization**, and this is the one project that runs it.

      `FrameworkElement.Language` defaults to the XML language "en-US", and any binding that has to
      convert a value - a `StringFormat`, a converter, or simply an int reaching a `Text` property -
      resolves it through `XmlLanguage.GetSpecificCulture()`. With the invariant switch on there is
      no non-neutral culture to find, so that call throws `InvalidOperationException` and the
      exception escapes through the window's message loop, which ends the process.

      The failure is not at start-up and not at build: it waits for the first such binding. The main
      window has none, because its rows are formatted into strings in the view model, so the
      application ran for weeks before the settings dialog - whose sliders show numbers - made the
      first one. Opening Settings killed the app.

      Every other project keeps the invariant setting from Directory.Build.props. It is a host-level
      switch, so this one governs only the application's own process.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeMosaicStudio.Application\DeMosaicStudio.Application.csproj" />
    <ProjectReference Include="..\DeMosaicStudio.Domain\DeMosaicStudio.Domain.csproj" />
    <ProjectReference Include="..\DeMosaicStudio.Infrastructure\DeMosaicStudio.Infrastructure.csproj" />
  </ItemGroup>

</Project>
