<Window x:Class="DeMosaicStudio.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeMosaic Studio" Height="560" Width="920"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Add videos…" Click="OnAdd" InputGestureText="Ctrl+O" />
                <MenuItem Header="Add _folder…" Click="OnAddFolder" />
                <Separator />
                <MenuItem Header="_Remove selected" Click="OnRemove" InputGestureText="Del" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Queue">
                <MenuItem Header="_Start" Click="OnStart" IsEnabled="{Binding CanStart}" />
                <MenuItem Header="Sto_p" Click="OnStop" IsEnabled="{Binding CanStop}" />
                <Separator />
                <MenuItem Header="Re_try selected" Click="OnRetry" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Settings…" Click="OnSettings" />
            </MenuItem>
        </Menu>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Add videos…" Click="OnAdd" />
                <Button Content="Remove" Click="OnRemove" />
                <Button Content="Retry" Click="OnRetry" />
                <Separator Width="12" Opacity="0" />
                <Button Content="Start" Click="OnStart" IsEnabled="{Binding CanStart}" />
                <Button Content="Stop" Click="OnStop" IsEnabled="{Binding CanStop}" />
                <Separator Width="12" Opacity="0" />
                <Button Content="Settings…" Click="OnSettings" />
            </StackPanel>

            <Grid Grid.Row="1">
                <ListView x:Name="Jobs" ItemsSource="{Binding Rows}" SelectionMode="Extended">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Video" Width="280"
                                            DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Status" Width="100"
                                            DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Header="Progress" Width="80"
                                            DisplayMemberBinding="{Binding Progress}" />
                            <GridViewColumn Header="Detail" Width="380"
                                            DisplayMemberBinding="{Binding Detail}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Shown only while the queue is empty, so the window says what to do with it. -->
                <TextBlock IsHitTestVisible="False" Opacity="0.45"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center"
                           Text="Drop videos or a folder here&#x0a;or use Add videos…">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="{Binding Status}" Opacity="0.8" />

            <!--
                prd.md §1.3. The output is an estimate wherever the mosaic destroyed information, and
                the application says so where the user is looking rather than only in a summary field.
            -->
            <TextBlock Grid.Row="3" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.65"
                       Text="Restored areas are generated from surrounding frames. They are an estimate, not recovered original detail, and must not be treated as a record of what was there." />
        </Grid>
    </DockPanel>
</Window>
