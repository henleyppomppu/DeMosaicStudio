<Window x:Class="DeMosaicStudio.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeMosaic Studio" Height="560" Width="920"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="영상 추가(_A)…" Click="OnAdd" InputGestureText="Ctrl+O" />
                <MenuItem Header="폴더 추가(_D)…" Click="OnAddFolder" />
                <Separator />
                <MenuItem Header="선택 항목 제거(_R)" Click="OnRemove" InputGestureText="Del" />
                <Separator />
                <MenuItem Header="끝내기(_X)" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="대기열(_Q)">
                <MenuItem Header="시작(_S)" Click="OnStart" IsEnabled="{Binding CanStart}" />
                <MenuItem Header="중지(_P)" Click="OnStop" IsEnabled="{Binding CanStop}" />
                <Separator />
                <MenuItem Header="선택 항목 다시 시도(_T)" Click="OnRetry" />
            </MenuItem>
            <MenuItem Header="도구(_T)">
                <MenuItem Header="설정(_S)…" Click="OnSettings" />
            </MenuItem>
        </Menu>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="영상 추가…" Click="OnAdd" />
                <Button Content="제거" Click="OnRemove" />
                <Button Content="다시 시도" Click="OnRetry" />
                <Separator Width="12" Opacity="0" />
                <Button Content="시작" Click="OnStart" IsEnabled="{Binding CanStart}" />
                <Button Content="중지" Click="OnStop" IsEnabled="{Binding CanStop}" />
                <Separator Width="12" Opacity="0" />
                <Button Content="설정…" Click="OnSettings" MinWidth="76" />
            </StackPanel>

            <Grid Grid.Row="1">
                <ListView x:Name="Jobs" ItemsSource="{Binding Rows}" SelectionMode="Extended">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="영상" Width="280"
                                            DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="상태" Width="100"
                                            DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Header="진행" Width="70"
                                            DisplayMemberBinding="{Binding Progress}" />
                            <GridViewColumn Header="내용" Width="390"
                                            DisplayMemberBinding="{Binding Detail}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Shown only while the queue is empty, so the window says what to do with it. -->
                <TextBlock IsHitTestVisible="False" Opacity="0.45"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center"
                           Text="영상이나 폴더를 여기에 끌어다 놓으세요&#x0a;또는 &quot;영상 추가…&quot;">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="{Binding Status}" Opacity="0.8" />

            <!--
                prd.md §1.3. The output is an estimate wherever the mosaic destroyed information, and
                the application says so where the user is looking rather than only in a summary field.
                The Korean must keep all three claims: generated from other frames, an estimate, and
                not a record of what was there.
            -->
            <TextBlock Grid.Row="3" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.65"
                       Text="복원된 영역은 주변 프레임으로부터 만들어 낸 것입니다. 추정이지 되찾은 원본이 아니며, 그곳에 무엇이 있었는지에 대한 기록으로 취급해서는 안 됩니다." />
        </Grid>
    </DockPanel>
</Window>
