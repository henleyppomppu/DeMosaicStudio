<Window x:Class="DeMosaicStudio.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeMosaicStudio.App.ViewModels"
        Title="설정" Height="640" Width="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="기본값으로" Click="OnRestoreDefaults" MinWidth="110" />
            <Button Content="취소" Click="OnCancel" IsCancel="True" />
            <Button Content="확인" Click="OnAccept" IsDefault="True" Margin="0" />
        </StackPanel>

        <TabControl>
            <TabItem Header="탐지">
                <StackPanel Margin="14">
                    <TextBlock Style="{StaticResource Label}" Text="탐지 확신도" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding Confidence, StringFormat=F2}" />
                        <Slider Minimum="0.10" Maximum="0.90" TickFrequency="0.01"
                                Value="{Binding Confidence}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="모자이크라고 판정하기 전에 탐지기가 얼마나 확신해야 하는지. 낮추면 더 많이 찾지만 모자이크가 아닌 것에도 더 많이 반응합니다 — 이 탐지기는 평범한 영상에서도 이미 과하게 반응하므로, 낮추는 것이 답인 경우는 드뭅니다." />

                    <TextBlock Style="{StaticResource Label}" Text="마스크 임계값" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding MaskThreshold, StringFormat=F2}" />
                        <Slider Minimum="0.30" Maximum="0.70" TickFrequency="0.01"
                                Value="{Binding MaskThreshold}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="탐지기가 낸 확률 지도를 어디에서 잘라 예/아니오 마스크로 만들지." />

                    <TextBlock Style="{StaticResource Label}" Text="가장 작은 영역 (화소)" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding MinRegionArea}" />
                        <Slider Minimum="64" Maximum="4096" TickFrequency="64"
                                Value="{Binding MinRegionArea}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="이보다 작은 영역은 무시합니다." />

                    <TextBlock Style="{StaticResource Label}" Text="복원 전 확인 프레임 수" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding MinConfirmFrames}" />
                        <Slider Minimum="1" Maximum="5" TickFrequency="1"
                                Value="{Binding MinConfirmFrames}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="한 영역을 건드리기 전에 연속 몇 프레임에서 보여야 하는지. 한 프레임짜리 오탐을 막는 가장 값싼 방법입니다." />

                    <TextBlock Style="{StaticResource Label}" Text="놓쳐도 유지할 프레임 수" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding MaxMissingFrames}" />
                        <Slider Minimum="0" Maximum="15" TickFrequency="1"
                                Value="{Binding MaxMissingFrames}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="탐지가 잠깐 끊겨도 추적을 몇 프레임까지 이어갈지." />

                    <TextBlock Style="{StaticResource Label}" Text="탐지 주기 (프레임)" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding DetectEvery}" />
                        <Slider Minimum="1" Maximum="8" TickFrequency="1"
                                Value="{Binding DetectEvery}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="몇 프레임마다 탐지기를 돌릴지. 사이 프레임은 추적기가 영역을 예측해 이어갑니다. 복원이 빨라진 뒤로는 탐지기가 프레임당 가장 큰 고정비용이라, 2로 두면 전체가 약 1.4배 빨라집니다. 새 영역은 최대 그만큼 늦게 잡힙니다." />
                </StackPanel>
            </TabItem>

            <TabItem Header="복원">
                <StackPanel Margin="14">
                    <TextBlock Style="{StaticResource Label}" Text="품질 사전 설정" />
                    <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Presets}"
                              SelectedItem="{Binding Preset}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Fast (기본): 격자를 지우고 부드럽게만 — 모델 없음, 가장 빠름, 실측에서 가장 좋았습니다. Balanced: 초해상도 망으로 질감을 만들어 넣음 — 모든 화소가 추정이며, 지금까지의 영상에서는 Fast보다 나쁘게 측정됐습니다. Quality: 이웃 프레임에서 근거를 모음, 약 2.5배 느림." />

                    <TextBlock Style="{StaticResource Label}" Text="시간 창" />
                    <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.TemporalWindows}"
                              SelectedItem="{Binding TemporalWindow}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="한 번의 복원에 이웃 프레임을 몇 장 쓸지. auto는 움직임을 보고 프레임마다 정합니다. 고정값을 골라도 장면 전환·메모리 부족 같은 안전 규칙에 따른 축소는 그대로 적용됩니다." />

                    <TextBlock Style="{StaticResource Label}" Text="최소 정렬 확신도" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding AlignConfMin, StringFormat=F2}" />
                        <Slider Minimum="0" Maximum="1" TickFrequency="0.01"
                                Value="{Binding AlignConfMin}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="이보다 낮게 정렬된 이웃 프레임은 근거로 쓰지 않습니다." />

                    <TextBlock Style="{StaticResource Label}" Text="확신도 게이트" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding MinRestorationConfidence, StringFormat=F2}" />
                        <Slider Minimum="0" Maximum="1" TickFrequency="0.01"
                                Value="{Binding MinRestorationConfidence}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="0이면 끕니다. 0보다 크면, 확신이 부족한 영역은 추측으로 덮어쓰는 대신 원본 화소를 그대로 둡니다. 쓸모 있는 구간 근처에서 매우 예민합니다 — 한 클립에서 재보니 0.87은 품질을 잃고 0.88은 얻었습니다." />

                    <TextBlock Style="{StaticResource Label}" Text="경계 번짐 폭 (화소)" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding FeatherWidth}" />
                        <Slider Minimum="1" Maximum="9" TickFrequency="1"
                                Value="{Binding FeatherWidth}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="복원한 영역을 주변에 얼마나 넓게 섞어 넣을지." />

                    <TextBlock Style="{StaticResource Label}" Text="시간 혼합 (새 프레임 비중)" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding TemporalAlpha, StringFormat=F2}" />
                        <Slider Minimum="0" Maximum="1" TickFrequency="0.05"
                                Value="{Binding TemporalAlpha}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Fast·Balanced에서 이번 프레임의 복원 결과를 이전 결과와 섞는 비율. 0.3이면 7:3입니다. 낮출수록 깜빡임이 줄고 움직임이 번집니다. Quality에서는 무시됩니다." />
                </StackPanel>
            </TabItem>

            <TabItem Header="다듬기">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14">
                    <CheckBox IsChecked="{Binding RefineEnabled}" Content="확산 모델로 복원 영역 다듬기" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="복원된 영역 위에 이미지-투-이미지 확산 모델을 낮은 강도로 한 번 더 돌립니다. 만들어 낸 화소입니다 — 프롬프트도, 참조 이미지도 없고, 특정 인물을 향하게 할 방법이 없습니다. 실측(D-44): 강도 0.2에서 bicubic보다 LPIPS 43% 좋음, 0.3부터 없는 형태를 만들기 시작, 0.5는 창작. 영역당 약 0.13초, VRAM +2.2 GB." />

                    <TextBlock Style="{StaticResource Label}" Text="모델 폴더" />
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="열기" Click="OnOpenStore" MinWidth="60" Margin="4,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="찾아보기…" Click="OnBrowseStore" MinWidth="90" Margin="4,0,0,0" />
                        <TextBox Text="{Binding StoreRoot, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{Binding EffectiveStoreRoot, StringFormat='비우면 프로그램 옆을 씁니다. 지금 읽는 곳: {0}  — 그 아래에 diffusion\, lora\, embeddings\ 폴더를 만들어 파일을 넣으세요. 큰 파일이니 아무 드라이브나 됩니다.'}" />

                    <TextBlock Style="{StaticResource Label}" Text="모델 (diffusion\ 폴더)" />
                    <ComboBox ItemsSource="{Binding DiffusionModels}" SelectedItem="{Binding RefineModel}"
                              IsEnabled="{Binding RefineEnabled}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="diffusers 형식 폴더(model_index.json 포함) 또는 단일 .safetensors 체크포인트를 담은 폴더 하나가 모델 하나입니다. SD1.5 계열이 검증됐습니다." />

                    <TextBlock Style="{StaticResource Label}" Text="LoRA (lora\ 폴더)" />
                    <ComboBox ItemsSource="{Binding Loras}" SelectedItem="{Binding RefineLora}"
                              IsEnabled="{Binding RefineEnabled}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="LCM LoRA를 고르면 4~8스텝으로 충분해집니다. 없으면 스텝을 20 이상으로 올려야 하고 그만큼 느립니다." />

                    <TextBlock Style="{StaticResource Label}" Text="임베딩 (embeddings\ 폴더)" />
                    <ItemsControl ItemsSource="{Binding EmbeddingChoices}" IsEnabled="{Binding RefineEnabled}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="특정 인물을 재현하도록 학습된 임베딩이나 LoRA는 이 프로그램의 범위 밖입니다(§2.3 C-4). 프로그램은 구분할 수 없고, 고르는 사람은 할 수 있습니다." />

                    <TextBlock Style="{StaticResource Label}" Text="강도" />
                    <DockPanel IsEnabled="{Binding RefineEnabled}">
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding RefineStrength, StringFormat=F2}" />
                        <Slider Minimum="0" Maximum="1" TickFrequency="0.05"
                                Value="{Binding RefineStrength}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="0은 아무것도 안 함. 0.2 권장. 0.3 넘기면 관측을 버리고 지어냅니다." />

                    <TextBlock Style="{StaticResource Label}" Text="스텝" />
                    <DockPanel IsEnabled="{Binding RefineEnabled}">
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding RefineSteps}" />
                        <Slider Minimum="1" Maximum="16" TickFrequency="1"
                                Value="{Binding RefineSteps}" />
                    </DockPanel>

                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="출력">
                <StackPanel Margin="14">
                    <TextBlock Style="{StaticResource Label}" Text="코덱" />
                    <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Codecs}"
                              SelectedItem="{Binding Codec}" Margin="0,0,0,10" />

                    <TextBlock Style="{StaticResource Label}" Text="인코더" />
                    <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Profiles}"
                              SelectedItem="{Binding Profile}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="QualityX265는 더 낮은 비트레이트에서 원본과 구분되지 않는 지점에 도달합니다. SpeedNvenc는 긴 파일과 반복 실험용입니다." />

                    <TextBlock Style="{StaticResource Label}" Text="고정 품질" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding ConstantQuality}" />
                        <Slider Minimum="0" Maximum="51" TickFrequency="1"
                                Value="{Binding ConstantQuality}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="낮을수록 좋고 파일이 커집니다." />

                    <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                               Text="파이프라인이 아무것도 바꾸지 않은 영상은 다시 인코딩하지 않고 그대로 복사합니다. 그러니 이 설정들은 실제로 복원이 일어난 파일에만 적용됩니다." />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
