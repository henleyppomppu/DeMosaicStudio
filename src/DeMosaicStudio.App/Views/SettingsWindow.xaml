<Window x:Class="DeMosaicStudio.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeMosaicStudio.App.ViewModels"
        Title="Settings" Height="620" Width="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Restore defaults" Click="OnRestoreDefaults" MinWidth="120" />
            <Button Content="Cancel" Click="OnCancel" IsCancel="True" />
            <Button Content="OK" Click="OnAccept" IsDefault="True" Margin="0" />
        </StackPanel>

        <TabControl>
            <TabItem Header="Detection">
                <StackPanel Margin="14">
                    <TextBlock Style="{StaticResource Label}" Text="Detection confidence" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding Confidence, StringFormat=F2}" />
                        <Slider Minimum="0.10" Maximum="0.90" TickFrequency="0.01"
                                Value="{Binding Confidence}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="How sure the detector must be before a region counts. Lower finds more and fires on more that is not a mosaic — on ordinary footage this detector already fires far more often than it should, so lowering it is rarely the answer." />

                    <TextBlock Style="{StaticResource Label}" Text="Mask threshold" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding MaskThreshold, StringFormat=F2}" />
                        <Slider Minimum="0.30" Maximum="0.70" TickFrequency="0.01"
                                Value="{Binding MaskThreshold}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Where the detector's probability map is cut into a yes/no mask." />

                    <TextBlock Style="{StaticResource Label}" Text="Smallest region (pixels)" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding MinRegionArea}" />
                        <Slider Minimum="64" Maximum="4096" TickFrequency="64"
                                Value="{Binding MinRegionArea}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Regions smaller than this are ignored." />

                    <TextBlock Style="{StaticResource Label}" Text="Confirmations before restoring" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding MinConfirmFrames}" />
                        <Slider Minimum="1" Maximum="5" TickFrequency="1"
                                Value="{Binding MinConfirmFrames}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Consecutive frames a region must be seen in before it is touched. Raising it is the cheapest defence against a single-frame false positive." />

                    <TextBlock Style="{StaticResource Label}" Text="Frames a track survives unseen" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding MaxMissingFrames}" />
                        <Slider Minimum="0" Maximum="15" TickFrequency="1"
                                Value="{Binding MaxMissingFrames}" />
                    </DockPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Restoration">
                <StackPanel Margin="14">
                    <TextBlock Style="{StaticResource Label}" Text="Quality preset" />
                    <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Presets}"
                              SelectedItem="{Binding Preset}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Trades throughput against temporal context." />

                    <TextBlock Style="{StaticResource Label}" Text="Temporal window" />
                    <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.TemporalWindows}"
                              SelectedItem="{Binding TemporalWindow}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="How many neighbouring frames feed one restoration. Auto chooses per frame from motion; a fixed value replaces only that choice, and the safety reductions still apply." />

                    <TextBlock Style="{StaticResource Label}" Text="Minimum alignment confidence" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding AlignConfMin, StringFormat=F2}" />
                        <Slider Minimum="0" Maximum="1" TickFrequency="0.01"
                                Value="{Binding AlignConfMin}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Neighbours aligned less confidently than this are not used as evidence." />

                    <TextBlock Style="{StaticResource Label}" Text="Confidence gate" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding MinRestorationConfidence, StringFormat=F2}" />
                        <Slider Minimum="0" Maximum="1" TickFrequency="0.01"
                                Value="{Binding MinRestorationConfidence}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Zero is off. Above zero, a region the pipeline is not confident about keeps its original pixels instead of being replaced by a guess. The setting is sharp near its useful value — measured on one clip, 0.87 lost quality and 0.88 gained it." />

                    <TextBlock Style="{StaticResource Label}" Text="Feather width (pixels)" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding FeatherWidth}" />
                        <Slider Minimum="1" Maximum="9" TickFrequency="1"
                                Value="{Binding FeatherWidth}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="How far the restored area is blended into its surroundings." />
                </StackPanel>
            </TabItem>

            <TabItem Header="Output">
                <StackPanel Margin="14">
                    <TextBlock Style="{StaticResource Label}" Text="Codec" />
                    <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Codecs}"
                              SelectedItem="{Binding Codec}" Margin="0,0,0,10" />

                    <TextBlock Style="{StaticResource Label}" Text="Encoder" />
                    <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Profiles}"
                              SelectedItem="{Binding Profile}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="x265 reaches transparency at a lower bitrate; NVENC is for long files and iteration." />

                    <TextBlock Style="{StaticResource Label}" Text="Constant quality" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                   Text="{Binding ConstantQuality}" />
                        <Slider Minimum="0" Maximum="51" TickFrequency="1"
                                Value="{Binding ConstantQuality}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Lower is better and larger." />

                    <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                               Text="A video the pipeline changed nothing in is copied rather than re-encoded, so these settings do not touch it at all. They apply only where something was restored." />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
